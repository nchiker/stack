<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- In-app updates (AppUpdater): Android still asks the person before installing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <!-- Filen Files hands Stack a backup folder in Filen Drive (FilenFolder). -->
        <intent><action android:name="app.filenfiles.action.GRANT_BACKUP_FOLDER" /></intent>
        <!-- Folder sharing (FilenPartner): partner setup, the share confirm sheet, the shared scan folder, and the partner/share-state calls. -->
        <intent><action android:name="app.filenfiles.action.PARTNER_SETUP" /></intent>
        <intent><action android:name="app.filenfiles.action.SHARE_WITH_PARTNER" /></intent>
        <intent><action android:name="app.filenfiles.action.CREATE_SHARED_FOLDER" /></intent>
        <provider android:authorities="app.filenfiles.stacklink" />
        <package android:name="app.amipro.editor"/>
        <package android:name="app.filenfiles"/>
    </queries>
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <application
        android:name=".StackApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_stack"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <service android:name=".SyncJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".PhotoImportJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".AutoBackupJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".SourceIndexJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <!-- Reads the text of folder files, one at a time, and draws pages for the viewer, in an ISOLATED process (ExtractService): another uid with no access to Stack's files, database, keys or the network; a bad file can kill that process, never Stack. -->
        <service android:name=".ExtractService" android:process=":extract" android:isolatedProcess="true" android:exported="false" />
        <!-- Tesseract needs a directory to start from, which an isolated process cannot have: OCR of drawn pages (pixels only) runs here, not isolated. -->
        <service android:name=".OcrService" android:process=":ocr" android:exported="false" />
        <service android:name=".RenderService" android:process=":render" android:isolatedProcess="true" android:exported="false" />
        <activity android:name=".PdfSelectionActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.GET_CONTENT"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.OPENABLE"/><data android:mimeType="application/pdf"/></intent-filter>
        </activity>
        <activity android:name=".LockActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".StackEditorActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".BatchActivity" android:exported="false" />
        <activity android:name=".MetadataEditorActivity" android:exported="false" />
        <activity android:name=".LibraryResetActivity" android:exported="false" />
        <activity android:name=".BackupActivity" android:exported="false" />
        <activity android:name=".TrashActivity" android:exported="false" />
        <activity android:name=".DuplicatesActivity" android:exported="false" />
        <activity android:name=".PairingQrActivity" android:exported="false" />
        <activity android:name=".SyncActivity" android:exported="false" />
        <activity android:name=".CompanionsActivity" android:exported="false" />
        <activity android:name=".DocumentActivity" android:exported="false" />
        <activity android:name=".LinkActivity" android:exported="false" />
        <activity android:name=".FoldersActivity" android:exported="false" />
        <activity android:name=".SourceViewerActivity" android:exported="false" />
        <activity android:name=".ScanActivity" android:exported="false" />
        <activity android:name=".PageEditorActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".MultipleImport" android:targetActivity=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/pdf"/><data android:mimeType="image/*"/></intent-filter>
        </activity-alias>
        <!-- Stack Link: owner apps (AmiPro, ...) send link records here. Every call is checked against the caller's
             package and signing certificate in LinkCallers; see docs/STACK_LINK_CONTRACT.md. -->
        <provider
            android:name=".LinkProvider"
            android:authorities="${applicationId}.link"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name=".ExportProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <!-- Filen Files sends SHARED_CHANGED as an explicit broadcast to this package. A manifest receiver was chosen over a dynamic one because an
             explicit broadcast is not limited by the Android 8+ implicit-broadcast rules or Android 14 context-registered rules, and it still reaches
             Stack when its process is not running. It only asks for the same debounced import as every other trigger, so a spoofed broadcast can do
             nothing more than a re-check (see PartnerChangeReceiver). -->
        <receiver android:name=".PartnerChangeReceiver" android:exported="true">
            <intent-filter><action android:name="app.filenfiles.action.SHARED_CHANGED" /></intent-filter>
        </receiver>
    </application>
</manifest>
